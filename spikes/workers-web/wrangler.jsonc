{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "happy-cookie-ops-workers-spike",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-08",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../../build/pages-spike/public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
