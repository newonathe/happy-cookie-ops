      "typescript": ">=3.3.1"
    },
    "scripts": {
      "dev": "pnpm build",
      "build": "swc -d dist src && pnpm types",
      "types": "tsc --skipLibCheck --declaration --emitDeclarationOnly --esModuleInterop --declarationDir dist --rootDir src",
      "pack-for-isolated-tests": "pnpm pack --out ./packed.tgz"
    }
