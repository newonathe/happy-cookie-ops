{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sanitized project event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "eventId", "sequence", "projectId", "runId", "taskId", "kind", "recordedAt", "summary", "evidence", "previousHash", "eventHash"],
  "properties": {
    "schemaVersion": {"const": 1},
    "eventId": {"type": "string", "format": "uuid"},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "projectId": {"type": "string", "minLength": 1, "maxLength": 120},
    "runId": {"type": "string", "format": "uuid"},
    "taskId": {"type": "string", "minLength": 1, "maxLength": 120},
    "kind": {"enum": ["task_claimed", "run_started", "command_started", "command_completed", "mutation_intent", "mutation_result", "outcome_unknown", "checkpoint", "verification", "review", "decision", "quota_observed", "waiting_quota", "blocked_input", "interrupted", "resumed", "completed", "cancelled", "superseded", "failed_environment"]},
    "recordedAt": {"type": "string", "format": "date-time"},
    "occurredAt": {"type": ["string", "null"], "format": "date-time"},
    "summary": {"type": "string", "maxLength": 2000},
    "operationId": {"type": ["string", "null"], "maxLength": 120},
    "codeSha": {"type": ["string", "null"], "pattern": "^[a-f0-9]{40,64}$"},
    "exitCode": {"type": ["integer", "null"]},
    "resetsAt": {"type": ["string", "null"], "format": "date-time"},
    "evidence": {"type": "array", "maxItems": 50, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "maxLength": 500}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}},
    "previousHash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "eventHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
