# Next.js demo app (Vercel preview). Supabase is deprecating the legacy anon and
# service_role keys by the end of 2026, and new projects use publishable (sb_publishable_…)
# and secret (sb_secret_…) keys instead. Migrate these before the first new hosted project
# (docs/state/decision-register.md).
# Supabase — from the project dashboard, Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never expose this to the browser; it bypasses row-level security.
SUPABASE_SERVICE_ROLE_KEY=

# The session BFF (Cloudflare Pages Function spike) does NOT read this file. Its bindings
# are listed in spikes/pages/bindings.example (passed as --binding flags locally) and are set as platform secrets for
# any hosted preview. Never give them a NEXT_PUBLIC_ name or put them in the static build.

# Set to 0 in production to hide the prototype harness (device, role and width pickers).
NEXT_PUBLIC_HARNESS=1

# Error reporting. Leave empty and Sentry stays switched off entirely — the app runs
# fine without it, and local development should not report to a shared project.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Needed only at build time, to upload source maps.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Tags every report so you can tell production from a preview deploy.
NEXT_PUBLIC_ENVIRONMENT=development
NEXT_PUBLIC_RELEASE=

# Rate limiting is Postgres-backed and needs no configuration. Set to 0 only to switch
# it off while load testing your own machine.
RATE_LIMIT_ENABLED=1

# SMS. Leave empty and messaging stays off — the stub logs and reports not-sent, so every
# code path around it still works. Costs money per message: read docs/MESSAGING.md and get
# the owner's agreement before filling these in.
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=
